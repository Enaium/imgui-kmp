headers = imgui_c.h implot_c.h implot3d_c.h node_editor_c.h file_dialog_c.h text_editor_c.h text_editor_extras_c.h text_editor_events_c.h markdown_c.h memory_editor_c.h multi_context_compositor_c.h threaded_rendering_c.h cinterop_helpers.h
compilerOpts = -std=c11

# SDL3's Windows backends reference these system libraries (SDL's own CMake
# links kernel32 user32 gdi32 winmm imm32 ole32 oleaut32 version uuid advapi32
# setupapi shell32 hid mincore). The sdl-kmp klib carries only a subset for
# mingwX64, so an executable linking this module on Windows also has to pull in
# the rest; the options are propagated to every consumer of the klib.
linkerOpts.mingw = -loleaut32 -lhid -ladvapi32 -lmincore
